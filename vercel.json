{
  "functions": { "api/ewg.js": { "includeFiles": "js/**" } },
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/view", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/js/pricing.js", "headers": [{ "key": "Cache-Control", "value": "private, no-cache" }] }
  ]
}
